import numpy as np

# Student marks
marks = np.array([85, 78, 92, 67, 88, 95, 73, 81])

print("Student Marks:", marks)

# Average marks
average = np.mean(marks)
print("Average Marks:", average)

# Highest marks
highest = np.max(marks)
print("Highest Marks:", highest)

# Lowest marks
lowest = np.min(marks)
print("Lowest Marks:", lowest)

# Total marks
total = np.sum(marks)
print("Total Marks:", total)

# Number of students passed (marks >= 40)
passed = np.sum(marks >= 40)
print("Students Passed:", passed)

# Grade Assignment
grades = np.where(marks >= 90, "A",
         np.where(marks >= 75, "B",
         np.where(marks >= 50, "C", "F")))

print("Grades:", grades)