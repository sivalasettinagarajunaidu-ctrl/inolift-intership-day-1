import pandas as pd
import matplotlib.pyplot as plt

# Load Dataset
df = pd.read_csv("diabetes.csv")

# Average values
avg_glucose = df["Glucose"].mean()
avg_bmi = df["BMI"].mean()
avg_age = df["Age"].mean()

# Data
features = ["Glucose", "BMI", "Age"]
values = [avg_glucose, avg_bmi, avg_age]

# Color List
colors = ["red", "green", "blue"]

plt.figure(figsize=(8,5))

bars = plt.bar(
    features,
    values,
    color=colors,
    edgecolor="black",
    linewidth=2
)

# Horizontal Reference Line
plt.axhline(
    y=avg_glucose,
    color="orange",
    linestyle="--",
    linewidth=2,
    label=f"Avg Glucose = {avg_glucose:.2f}"
)

# Labels
plt.title("Diabetes Dataset Feature Comparison",
          fontsize=14,
          fontweight="bold")

plt.xlabel("Features")
plt.ylabel("Average Value")

# Legend
plt.legend()

# Value Labels on Bars
for bar in bars:
    plt.text(
        bar.get_x() + bar.get_width()/2,
        bar.get_height() + 2,
        f"{bar.get_height():.1f}",
        ha="center"
    )

plt.grid(axis="y", linestyle=":")
plt.tight_layout()

plt.savefig("custom_diabetes_chart.png")
plt.show()